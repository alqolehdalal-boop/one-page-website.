<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>One Page Website</title>

<style>
/* 1. Style your gallery images */
.gallery-img {
width: 200px;
height: 150px;
object-fit: cover;
cursor: pointer;
margin: 10px;
transition: 0.3s;
}
.gallery-img:hover { opacity: 0.7; }

/* 2. The Modal Backdrop (Hidden by default) */
.modal {
display: none;
position: fixed;
z-index: 999;
left: 0;
top: 0;
width: 100%;
height: 100%;
background-color: rgba(0, 0, 0, 0.9);
}

/* 3. The Close Button */
.close-btn {
position: absolute;
top: 15px;
right: 35px;
color: #f1f1f1;
font-size: 40px;
font-weight: bold;
cursor: pointer;
}

/* 4. The Enlarged Image */
.modal-content {
display: block;
margin: auto;
max-width: 80%;
max-height: 80%;
position: relative;
top: 50%;
transform: translateY(-50%);
}
</style>
</head>
<body>

<!-- Your website content, navigation, video, form go here -->

<!-- Gallery Section -->
<h2>My Image Gallery</h2>
<!-- Replace placeholder links with your actual image paths -->
<img class="gallery-img" src="https://picsum.photos" alt="Image 1">
<img class="gallery-img" src="https://picsum.photos" alt="Image 2">

<!-- The Lightbox Modal Structure -->
<div id="lightboxModal" class="modal">
<span class="close-btn">&times;</span>
<img class="modal-content" id="modalImg">
</div>

<!-- JavaScript Behavior -->
<script>
const modal = document.getElementById("lightboxModal");
const modalImg = document.getElementById("modalImg");
const closeBtn = document.querySelector(".close-btn");

// Click image -> Open modal and set image source
document.querySelectorAll(".gallery-img").forEach(img => {
img.addEventListener("click", () => {
modal.style.display = "block";
modalImg.src = img.src;
});
});

// Click close button -> Hide modal
closeBtn.addEventListener("click", () => {
modal.style.display = "none";
});

// Optional: Click outside the image -> Hide modal
modal.addEventListener("click", (e) => {
if (e.target === modal) {
modal.style.display = "none";
}
});
</script>

</body>
</html>


